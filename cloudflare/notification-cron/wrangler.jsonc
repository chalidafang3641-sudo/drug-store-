{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "drugstore-notification-cron",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": { "NOTIFICATION_URL": "https://drug-store-pi.vercel.app/api/notifications/scheduled" }
}
